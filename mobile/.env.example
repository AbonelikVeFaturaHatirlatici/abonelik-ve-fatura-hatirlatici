# Bu dosyayı .env olarak kopyalayın: cp .env.example .env  (.env git'e GİRMEZ)
# EXPO_PUBLIC_ değerleri uygulama paketine gömülür; buraya gizli bilgi yazmayın.

# API taban adresi. Android emülatörü için geliştirme makinesindeki localhost:8000 = 10.0.2.2:8000.
# Fiziksel cihazda bilgisayarın yerel ağ IP'sini yazın (ör. http://192.168.1.20:8000).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# true: ağ yerine bellek içi mock sunucu (backend veya Prism olmadan arayüz geliştirme).
EXPO_PUBLIC_USE_MOCK_API=false
